# Cấu hình backend Free2Do. Copy thành backend/.env rồi điền giá trị:
#   cp .env.example .env          (Windows: copy .env.example .env)
# Backend chỉ đọc backend/.env (app/config.py); biến môi trường hệ thống/Render ưu tiên hơn file này.
# KHÔNG commit file .env.

# ===== BẮT BUỘC: để trống thì backend không khởi động =====

# Chuỗi kết nối PostgreSQL. Supabase: Connect > Connection string (URI).
# Dạng: postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=

# Chuỗi ngẫu nhiên dài dùng để ký token đăng nhập. Tạo bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ===== TÙY CHỌN: để trống thì chỉ tính năng tương ứng không dùng được, app vẫn chạy =====

# Upload ảnh/video (avatar, logo, gallery, ảnh hoạt động) qua Supabase Storage.
# SUPABASE_SERVICE_KEY là secret server-side, không bao giờ đưa vào frontend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=free2do-media

# Gửi email OTP (quên mật khẩu, xác minh email khôi phục).
# auto = Gmail API nếu có GMAIL_API_REFRESH_TOKEN, ngược lại SMTP.
# Hướng dẫn: SMTP_GMAIL_SETUP.md (máy local) và GMAIL_API_RENDER_SETUP.md (Render Free chặn SMTP).
EMAIL_PROVIDER=auto
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# OAuth Client ID cho API POST /auth/google.
GOOGLE_CLIENT_ID=

# Trợ lý AI chạy được khi để trống; xem AI_SETUP.md.
OPENAI_API_KEY=

# Domain frontend được phép gọi API, phân tách bằng dấu phẩy (mặc định đã có localhost:5500).
# CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://free2-do.vercel.app

# Các thiết lập khác (thời hạn token/OTP, giới hạn upload, PostGIS, model AI) có mặc định
# trong app/config.py; chỉ thêm vào đây khi cần đổi.
