DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
OPERATOR_TOKEN_EXPIRE_MINUTES=180

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=free2do-media

# Render production: dùng Gmail API qua HTTPS/443.
EMAIL_PROVIDER=gmail_api
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Có thể dùng SMTP khi chạy local. Render Free thường chặn SMTP 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# OAuth đăng nhập bằng Google; khác với credential Gmail API nếu bạn tạo client riêng.
GOOGLE_CLIENT_ID=

# OpenAI Responses API (không đặt key ở frontend; API usage được tính riêng)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

OTP_EXPIRE_MINUTES=10
RESET_TOKEN_EXPIRE_MINUTES=10
MAX_IMAGE_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=25
POSTGIS_EXTENSION_ENABLED=true
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://free2-do.vercel.app

